# Copia este archivo a ".env" (en la raíz del proyecto) y completa los
# valores reales. NUNCA subas el archivo ".env" a un repositorio.

# URL del backend (server/) que consume el frontend (Vite). Opcional: si
# no la defines, se usa "http://localhost:4000" por defecto — alcanza
# para desarrollo local. Cámbiala solo si el backend corre en otra URL
# (otro puerto, otra máquina, o la URL real en producción).
# VITE_API_URL="http://localhost:4000"

# Lo siguiente es usado únicamente por scripts/sincronizar-imagenes.cjs
# para leer los recursos subidos a Cloudinary. No lo necesita el
# frontend (Vite) ni el backend (server/) para funcionar normalmente —
# el backend tiene sus propias variables CLOUDINARY_* en server/.env
# (para la subida de imágenes desde el panel admin).

# Panel de Cloudinary → Dashboard → "Product Environment Credentials"
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"
