# Ejemplo: reemplaza los marcadores mediante tu gestor de secretos.
# No uses estos valores para desplegar ni guardes credenciales en Git.
DATABASE_URL="postgresql://REPLACE_DB_USER:REPLACE_DB_PASSWORD@REPLACE_DB_HOST:5432/REPLACE_DB_NAME?sslmode=require"
PORT=4000
CORS_ORIGIN="https://REPLACE_FRONTEND_HOST"
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
# Un proxy (Render). 0 para acceso directo; solo enteros entre 0 y 5.
TRUST_PROXY=1

# Opcionales: habilitan correo, subidas y Google respectivamente.
RESEND_API_KEY="REPLACE_RESEND_API_KEY"
EMAIL_FROM="REPLACE_SENDER_NAME <REPLACE_SENDER_EMAIL>"
CLOUDINARY_CLOUD_NAME="REPLACE_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="REPLACE_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="REPLACE_CLOUDINARY_API_SECRET"
GOOGLE_CLIENT_ID="REPLACE_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="REPLACE_GOOGLE_CLIENT_SECRET"
GOOGLE_CALLBACK_URL="https://REPLACE_API_HOST/api/auth/google/callback"
