# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" (con datos reales) a un repositorio público.

# Cadena de conexión a PostgreSQL. Formato:
# postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD?schema=public
# Puedes obtenerla gratis en Railway, Render, Supabase o Neon.

DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST:5432/tecruta?schema=public

# Puerto en el que corre la API.
PORT=4000

# Origen permitido para CORS (la URL donde corre la web en desarrollo).
CORS_ORIGIN=http://localhost:5173

# Secreto para firmar los tokens de sesión (JWT). Usa un valor largo y
# aleatorio en producción — por ejemplo, generado con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REEMPLAZA_POR_48_BYTES_ALEATORIOS_EN_HEX

# Envío de correos transaccionales (verificación de cuenta y
# restablecimiento de contraseña) vía Resend: https://resend.com/api-keys
RESEND_API_KEY=re_REEMPLAZA_ESTA_CLAVE

# Remitente que verán los clientes. El dominio debe estar verificado en
# Resend (Dashboard → Domains) o el envío fallará.
EMAIL_FROM=TecRuta <no-reply@tu-dominio-verificado.com>

# Subida de imágenes de producto desde el panel admin (POST
# /api/admin/uploads). Mismas credenciales que usa scripts/sincronizar-imagenes.cjs
# — Panel de Cloudinary → Dashboard → "Product Environment Credentials".
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# Login con Google (botón "Continuar con Google" en /iniciar-sesion).
# Credenciales OAuth 2.0 de Google Cloud Console → APIs & Services →
# Credentials → OAuth 2.0 Client IDs (tipo "Web application").
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# URL exacta que Google llama de vuelta después del consentimiento — debe
# coincidir carácter por carácter con una de las "Authorized redirect URIs"
# configuradas en Google Cloud Console para este Client ID.
#
# Producción:
# GOOGLE_CALLBACK_URL=https://tecruta.onrender.com/api/auth/google/callback
#
# Desarrollo local:
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback