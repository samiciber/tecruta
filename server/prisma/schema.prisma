// Esquema de base de datos de TecRuta.
//
// Cubre lo que hoy vive disperso en localStorage / archivos estáticos del
// frontend (AuthContext, CartContext, products.js, paymentConfig.js) más
// las entidades nuevas necesarias para tener un sistema de ventas real:
// pedidos con estado, historial de compras y direcciones guardadas.
//
// Esta es la fuente única de verdad del modelo de datos. Tanto la web
// como una futura app móvil consumen esta misma base a través de la API,
// nunca directamente.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Cuentas y direcciones
// ---------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  nombre            String
  apellido          String
  fechaNacimiento   DateTime?
  role              Role      @default(CUSTOMER)
  verified          Boolean   @default(false)
  verificationCode  String?
  resetCode         String?
  // Id de cuenta de Google (campo `sub` del perfil) para cuentas creadas o
  // vinculadas vía "Continuar con Google". Null para cuentas que solo usan
  // correo/contraseña. Ver server/src/lib/google.js y la ruta
  // GET /api/auth/google/callback en auth.routes.js. passwordHash sigue
  // siendo obligatorio incluso para cuentas de Google: se genera uno
  // aleatorio e inutilizable en el momento de creación, para no tener que
  // volver nullable esa columna — el usuario puede definir una contraseña
  // real más adelante con el flujo existente de "olvidé mi contraseña".
  googleId          String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  addresses Address[]
  orders    Order[]
  cart      Cart?
  savedItems SavedItem[]

  @@map("users")
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  etiqueta     String? // "Casa", "Trabajo", etc. (opcional, uso futuro)
  departamento String
  provincia    String
  distrito     String
  direccion    String?
  numero       String?
  interior     String?
  referencia   String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("addresses")
}

// ---------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String?
  products    Product[]

  // --- Árbol de navegación (estilo bestbuy.com) ---
  // parentId = null → categoría de primer nivel (las 21 del "Menú").
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  position    Int        @default(0)
  visible     Boolean    @default(true)
  // legacy = true → las 8 categorías originales (power-banks, cargadores…).
  // No se muestran en menús/filtros/Home; solo en el admin.
  legacy      Boolean    @default(false)
  image       String?
  // Código de referencia de la taxonomía fuente (informativo, opcional).
  sourceRef   String?
  tiles       CategoryTile[]

  @@index([parentId])
  @@map("categories")
}

// Imágenes referenciales de la página de categoría (imagen + título + enlace).
model CategoryTile {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title      String
  image      String?
  href       String?
  position   Int      @default(0)
  visible    Boolean  @default(true)

  @@index([categoryId])
  @@map("category_tiles")
}

model Brand {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  logo             String?
  featured         Boolean   @default(false)
  featuredPosition Int       @default(0)
  visible          Boolean   @default(true)
  products         Product[]
  createdAt        DateTime  @default(now())

  @@map("brands")
}

enum NavItemType {
  LINK
  HEADING
  DIVIDER
  SUBMENU
  PROMO
}

// Ítems de los menús Acuerdos / Soporte / Descubre / Más y de los enlaces
// rápidos de la fila 2. menuKey: acuerdos | soporte | descubre | mas | quick
// parentId solo se usa para ítems de un SUBMENU (subnivel de Descubre).
// type PROMO: label/href se toman de SiteSetting "seasonalPromo".
model NavItem {
  id       String      @id @default(cuid())
  menuKey  String
  parentId String?
  parent   NavItem?    @relation("NavItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NavItem[]   @relation("NavItemTree")
  type     NavItemType @default(LINK)
  label    String
  href     String?
  position Int         @default(0)
  visible  Boolean     @default(true)

  @@index([menuKey, position])
  @@index([parentId])
  @@map("nav_items")
}

model PopularSearch {
  id       String  @id @default(cuid())
  text     String
  position Int     @default(0)
  active   Boolean @default(true)

  @@map("popular_searches")
}

model Store {
  id         String  @id @default(cuid())
  name       String
  address1   String
  address2   String?
  city       String
  postalCode String?
  opensAt    String? // "10:00"
  active     Boolean @default(true)
  isDefault  Boolean @default(false)
  position   Int     @default(0)

  @@map("stores")
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// Elementos guardados (lista de deseos). Se implementa en el Bloque 4.
model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("saved_items")
}

model Product {
  id               String         @id @default(cuid())
  slug             String         @unique
  name             String
  brand            String?
  description      String?
  shortDescription String?
  price            Decimal        @db.Decimal(10, 2)
  compareAtPrice   Decimal?       @db.Decimal(10, 2)
  stock            Int            @default(0)
  featured         Boolean        @default(false)
  bestSeller       Boolean        @default(false)
  image            String?
  tags             String[]
  specifications   Json?
  // --- Campos 3D (opcionales, aditivos) ---------------------------------
  // Ningún producto existente los tiene todavía; el frontend siempre
  // funciona con la galería de imágenes normal cuando faltan. Ver
  // Product3DViewer.jsx (src/components/3d/) para el consumo de estos
  // campos y el ProductForm del admin para su edición.
  model3DUrl       String? // URL pública del .glb/.gltf
  model3DPoster    String? // imagen de respaldo mientras carga o si el 3D falla
  enable3D         Boolean        @default(false)
  hotspots         Json? // [{ id, x, y, z, title, description }]
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  orderItems       OrderItem[]
  cartItems        CartItem[]
  savedItems       SavedItem[]
  // Marca normalizada (el campo `brand` de texto se conserva sin cambios).
  brandId          String?
  brandRef         Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ---------------------------------------------------------------------
// Métodos de pago (hoy: paymentConfig.js hardcodeado → administrable)
// ---------------------------------------------------------------------

model PaymentMethod {
  id     String  @id @default(cuid())
  key    String  @unique // 'yape' | 'plin' | 'bankTransfer' | 'cashOnDelivery'
  label  String
  active Boolean @default(true)
  // Datos específicos de cada método (phoneNumber/holderName/qrImageUrl,
  // o bankName/accountNumber/cci, etc.) — se guardan flexibles en JSON
  // porque cada método tiene campos distintos.
  config Json
  orders Order[]

  @@map("payment_methods")
}

// ---------------------------------------------------------------------
// Carrito persistente (para clientes con sesión iniciada; los invitados
// siguen usando localStorage en el frontend, sin cambios)
// ---------------------------------------------------------------------

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------
// Pedidos (hoy: solo un mensaje de WhatsApp, sin registro consultable)
// ---------------------------------------------------------------------

enum DeliveryType {
  SHIPPING
  PICKUP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id                String       @id @default(cuid())
  userId            String?
  user              User?        @relation(fields: [userId], references: [id])

  // Datos de cliente en el momento del pedido (se copian aquí aunque el
  // usuario esté logueado, para que el pedido quede intacto si luego el
  // cliente edita su perfil).
  customerNombre    String
  customerApellido  String
  customerCorreo    String
  customerCelular   String

  // Entrega
  deliveryType      DeliveryType
  departamento      String
  provincia         String
  distrito          String
  direccion         String?
  numero            String?
  interior          String?
  referencia        String?

  // Facturación
  quiereComprobante Boolean      @default(false)
  documento         String?
  otraPersona       Boolean      @default(false)
  personaNombre     String?
  personaCelular    String?

  // Pago y totales
  paymentMethodId   String?
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  subtotal          Decimal      @db.Decimal(10, 2)
  savings           Decimal      @db.Decimal(10, 2) @default(0)
  total             Decimal      @db.Decimal(10, 2)

  status            OrderStatus  @default(PENDING)
  whatsappSentAt    DateTime?

  // URL en Cloudinary del comprobante de pago (imagen o PDF). Se llena
  // vía POST /api/orders/:orderId/receipt (endpoint público, ver
  // orders.routes.js) — el cliente lo sube en el paso 3 del checkout, en
  // paralelo al envío por WhatsApp sin bloquearlo, y el admin puede
  // subirlo o reemplazarlo manualmente desde el panel reutilizando el
  // mismo endpoint. Null hasta que alguien lo suba.
  receiptUrl        String?

  items             OrderItem[]
  statusHistory     OrderStatusHistory[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String // copia del nombre al momento de la venta (histórico)
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@map("order_status_history")
}
