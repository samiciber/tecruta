// Esquema de base de datos de TecRuta.
//
// Cubre lo que hoy vive disperso en localStorage / archivos estáticos del
// frontend (AuthContext, CartContext, products.js, paymentConfig.js) más
// las entidades nuevas necesarias para tener un sistema de ventas real:
// pedidos con estado, historial de compras y direcciones guardadas.
//
// Esta es la fuente única de verdad del modelo de datos. Tanto la web
// como una futura app móvil consumen esta misma base a través de la API,
// nunca directamente.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

// ---------------------------------------------------------------------
// Cuentas y direcciones
// ---------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
  WAREHOUSE
  CASHIER
}

model User {
  id                String    @id @default(cuid())
  email             String?   @unique
  // Optional ADMIN login alias, stored as lowercase ASCII (email is retained).
  adminUsername     String?   @unique
  isSuspended       Boolean   @default(false)
  mustChangePassword Boolean  @default(false)
  temporaryPasswordExpiresAt DateTime?
  ownerRecoveryEnabled Boolean @default(false)
  mfaSecretEncrypted String?
  mfaPendingSecretEncrypted String?
  mfaEnabled Boolean @default(false)
  mfaLastStep Int?
  mfaRecoveryHashes Json?
  staffSessions StaffSession[]
  staffLoginChallenges StaffLoginChallenge[]
  auditEvents StaffAuditEvent[]
  passwordHash      String
  nombre            String
  apellido          String
  fechaNacimiento   DateTime?
  role              Role      @default(CUSTOMER)
  verified          Boolean   @default(false)
  verificationCode  String?
  resetCode         String?
  // Legacy plaintext codes are invalidated; only keyed hashes are used.
  verificationCodeHash        String?
  verificationCodeExpiresAt   DateTime?
  verificationCodeAttempts    Int?
  verificationCodeLockedUntil DateTime?
  verificationCodeSentAt      DateTime?
  resetCodeHash               String?
  resetCodeExpiresAt          DateTime?
  resetCodeAttempts           Int?
  resetCodeLockedUntil        DateTime?
  resetCodeSentAt             DateTime?
  tokenVersion                Int? @default(0)
  // Id de cuenta de Google (campo `sub` del perfil) para cuentas creadas o
  // vinculadas vía "Continuar con Google". Null para cuentas que solo usan
  // correo/contraseña. Ver server/src/lib/google.js y la ruta
  // GET /api/auth/google/callback en auth.routes.js. passwordHash sigue
  // siendo obligatorio incluso para cuentas de Google: se genera uno
  // aleatorio e inutilizable en el momento de creación, para no tener que
  // volver nullable esa columna — el usuario puede definir una contraseña
  // real más adelante con el flujo existente de "olvidé mi contraseña".
  googleId          String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  addresses Address[]
  orders    Order[]
  cart      Cart?
  savedItems SavedItem[]
  authExchanges AuthExchange[]
  inventoryMovements          InventoryMovement[] @relation("InventoryMovementActor")
  confirmedInventoryMovements InventoryMovement[] @relation("InventoryMovementConfirmer")
  cashSessions CashSession[]
  cashEntries CashEntry[]
  posSales PosSale[] @relation("PosSaleActor")
  approvedPosSales PosSale[] @relation("PosSaleApprover")
  posPayments PosPayment[]
  posRefunds PosRefund[]
  posOperations PosOperation[]
  reviews ProductReview[] @relation("ReviewAuthor")
  moderatedReviews ProductReview[] @relation("ReviewModerator")
  reviewVotes ReviewHelpfulVote[]

  @@map("users")
}

// Short-lived OAuth state bound to an HttpOnly browser cookie.
model StaffSession {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  @@index([userId, expiresAt])
  @@map("staff_sessions")
}

model StaffLoginChallenge {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenVersion Int
  attempts Int @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
  @@map("staff_login_challenges")
}

model StaffAuditEvent {
  id String @id @default(cuid())
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  subjectId String?
  action String
  detail Json
  createdAt DateTime @default(now())
  @@index([createdAt, id])
  @@index([subjectId, createdAt])
  @@map("staff_audit_events")
}

model OAuthFlow {
  id            String   @id @default(cuid())
  stateHash     String   @unique
  bindingHash   String
  exchangeChallenge String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([expiresAt])
  @@map("oauth_flows")
}

// One-use frontend exchange code; no session or provider token in the URL/DB.
model AuthExchange {
  id            String   @id @default(cuid())
  codeHash      String   @unique
  exchangeChallenge String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenVersion  Int
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([expiresAt])
  @@map("auth_exchanges")
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  etiqueta     String? // "Casa", "Trabajo", etc. (opcional, uso futuro)
  departamento String
  provincia    String
  distrito     String
  direccion    String?
  numero       String?
  interior     String?
  referencia   String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("addresses")
}

// ---------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String?
  products    Product[]

  // --- Árbol de navegación (estilo bestbuy.com) ---
  // parentId = null → categoría de primer nivel (las 21 del "Menú").
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  position    Int        @default(0)
  visible     Boolean    @default(true)
  // legacy = true → las 8 categorías originales (power-banks, cargadores…).
  // No se muestran en menús/filtros/Home; solo en el admin.
  legacy      Boolean    @default(false)
  image       String?
  // Código de referencia de la taxonomía fuente (informativo, opcional).
  sourceRef   String?
  tiles       CategoryTile[]

  @@index([parentId])
  @@map("categories")
}

// Imágenes referenciales de la página de categoría (imagen + título + enlace).
model CategoryTile {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title      String
  image      String?
  href       String?
  position   Int      @default(0)
  visible    Boolean  @default(true)

  @@index([categoryId])
  @@map("category_tiles")
}

model Brand {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  logo             String?
  featured         Boolean   @default(false)
  featuredPosition Int       @default(0)
  visible          Boolean   @default(true)
  products         Product[]
  createdAt        DateTime  @default(now())

  @@map("brands")
}

enum NavItemType {
  LINK
  HEADING
  DIVIDER
  SUBMENU
  PROMO
}

// Ítems de los menús Acuerdos / Soporte / Descubre / Más y de los enlaces
// rápidos de la fila 2. menuKey: acuerdos | soporte | descubre | mas | quick
// parentId solo se usa para ítems de un SUBMENU (subnivel de Descubre).
// type PROMO: label/href se toman de SiteSetting "seasonalPromo".
model NavItem {
  id       String      @id @default(cuid())
  menuKey  String
  parentId String?
  parent   NavItem?    @relation("NavItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NavItem[]   @relation("NavItemTree")
  type     NavItemType @default(LINK)
  label    String
  href     String?
  position Int         @default(0)
  visible  Boolean     @default(true)

  @@index([menuKey, position])
  @@index([parentId])
  @@map("nav_items")
}

model PopularSearch {
  id       String  @id @default(cuid())
  text     String
  position Int     @default(0)
  active   Boolean @default(true)

  @@map("popular_searches")
}

model Store {
  id         String  @id @default(cuid())
  name       String
  address1   String
  address2   String?
  city       String
  postalCode String?
  opensAt    String? // "10:00"
  active     Boolean @default(true)
  isDefault  Boolean @default(false)
  position   Int     @default(0)

  @@map("stores")
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// Elementos guardados (lista de deseos). Se implementa en el Bloque 4.
model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("saved_items")
}

model Product {
  id               String         @id @default(cuid())
  slug             String         @unique
  // El trigger inventory_assign_sku genera el valor si no se envía.
  sku              String         @unique @default(dbgenerated())
  name             String
  brand            String?
  description      String?
  shortDescription String?
  price            Decimal        @db.Decimal(10, 2)
  compareAtPrice   Decimal?       @db.Decimal(10, 2)
  stock            Int            @default(0)
  ratingCount      Int            @default(0)
  ratingSum        Int            @default(0)
  reviews          ProductReview[]
  featured         Boolean        @default(false)
  bestSeller       Boolean        @default(false)
  image            String?
  tags             String[]
  specifications   Json?
  // --- Campos 3D (opcionales, aditivos) ---------------------------------
  // Ningún producto existente los tiene todavía; el frontend siempre
  // funciona con la galería de imágenes normal cuando faltan. Ver
  // Product3DViewer.jsx (src/components/3d/) para el consumo de estos
  // campos y el ProductForm del admin para su edición.
  model3DUrl       String? // URL pública del .glb/.gltf
  model3DPoster    String? // imagen de respaldo mientras carga o si el 3D falla
  enable3D         Boolean        @default(false)
  hotspots         Json? // [{ id, x, y, z, title, description }]
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  orderItems       OrderItem[]
  cartItems        CartItem[]
  savedItems       SavedItem[]
  barcodes         ProductBarcode[]
  inventoryMovements InventoryMovement[]
  posSaleItems PosSaleItem[]
  // Marca normalizada (el campo `brand` de texto se conserva sin cambios).
  brandId          String?
  brandRef         Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_pos_name_search_idx")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_pos_sku_search_idx")
  @@map("products")
}

enum ProductBarcodeKind {
  MANUFACTURER
  INTERNAL
}

model ProductBarcode {
  id             String             @id @default(cuid())
  code           String
  normalizedCode String             @unique
  kind           ProductBarcodeKind
  productId      String
  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())

  @@index([productId])
  @@index([normalizedCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "barcodes_pos_search_idx")
  @@map("product_barcodes")
}

enum InventoryMovementType {
  INITIAL_BALANCE
  PURCHASE
  CUSTOMER_RETURN
  POSITIVE_ADJUSTMENT
  LOSS
  DAMAGE
  SUPPLIER_RETURN
  NEGATIVE_ADJUSTMENT
  WEB_ORDER
  WEB_CANCELLATION
  POS_SALE
  POS_RETURN
  REVERSAL
}

enum InventoryDirection {
  IN
  OUT
}

enum InventoryMovementStatus {
  DRAFT
  CONFIRMED
}

model InventoryMovement {
  id            String                  @id @default(cuid())
  productId     String
  product       Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  type          InventoryMovementType
  direction     InventoryDirection
  status        InventoryMovementStatus @default(DRAFT)
  quantity      Int
  balanceAfter  Int?
  reason        String
  reference     String?
  supplier      String?
  unitCost      Decimal?                @db.Decimal(10, 2)
  occurredAt    DateTime                @default(now())
  createdAt     DateTime                @default(now())
  confirmedAt   DateTime?
  createdById   String?
  createdBy     User?                   @relation("InventoryMovementActor", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedById String?
  confirmedBy   User?                   @relation("InventoryMovementConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  sourceKey     String?                 @unique
  reversalOfId  String?                 @unique
  reversalOf    InventoryMovement?      @relation("InventoryMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals     InventoryMovement[]     @relation("InventoryMovementReversal")

  @@index([productId, occurredAt, createdAt])
  @@index([type, occurredAt])
  @@index([status, occurredAt])
  @@index([createdById, occurredAt])
  @@map("inventory_movements")
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ---------------------------------------------------------------------
// Métodos de pago (hoy: paymentConfig.js hardcodeado → administrable)
// ---------------------------------------------------------------------

model PaymentMethod {
  id     String  @id @default(cuid())
  key    String  @unique // 'yape' | 'plin' | 'bankTransfer' | 'cashOnDelivery'
  label  String
  active Boolean @default(true)
  // Datos específicos de cada método (phoneNumber/holderName/qrImageUrl,
  // o bankName/accountNumber/cci, etc.) — se guardan flexibles en JSON
  // porque cada método tiene campos distintos.
  config Json
  orders Order[]

  @@map("payment_methods")
}

// ---------------------------------------------------------------------
// Carrito persistente (para clientes con sesión iniciada; los invitados
// siguen usando localStorage en el frontend, sin cambios)
// ---------------------------------------------------------------------

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------
// Pedidos (hoy: solo un mensaje de WhatsApp, sin registro consultable)
// ---------------------------------------------------------------------

enum DeliveryType {
  SHIPPING
  PICKUP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id                String       @id @default(cuid())
  userId            String?
  user              User?        @relation(fields: [userId], references: [id])

  // Datos de cliente en el momento del pedido (se copian aquí aunque el
  // usuario esté logueado, para que el pedido quede intacto si luego el
  // cliente edita su perfil).
  customerNombre    String
  customerApellido  String
  customerCorreo    String
  customerCelular   String

  // Entrega
  deliveryType      DeliveryType
  departamento      String
  provincia         String
  distrito          String
  direccion         String?
  numero            String?
  interior          String?
  referencia        String?

  // Facturación
  quiereComprobante Boolean      @default(false)
  documento         String?
  otraPersona       Boolean      @default(false)
  personaNombre     String?
  personaCelular    String?

  // Pago y totales
  paymentMethodId   String?
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  subtotal          Decimal      @db.Decimal(10, 2)
  savings           Decimal      @db.Decimal(10, 2) @default(0)
  total             Decimal      @db.Decimal(10, 2)

  status            OrderStatus  @default(PENDING)
  whatsappSentAt    DateTime?

  // URL en Cloudinary del comprobante de pago (imagen o PDF). Se llena
  // vía POST /api/orders/:orderId/receipt: propietario autenticado,
  // ADMIN o token por pedido de invitado. Se sube después de confirmar
  // la creación del pedido; la respuesta contiene solo ok y receiptUrl.
  receiptUrl        String?
  // Guest receipt capability (hash only) and a stable checkout retry key.
  receiptTokenHash  String?
  idempotencyKey    String?       @unique
  requestHash       String?

  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  emailDeliveries   OrderEmailDelivery[]
  posSale           PosSale?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String // copia del nombre al momento de la venta (histórico)
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  review ProductReview?
  reviewInvitation ReviewInvitation?

  @@index([orderId, productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, status, createdAt])
  @@map("order_status_history")
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum PosSaleStatus {
  PENDING
  CONFIRMED
  CANCELLED
  RETURNED
  VOIDED
}

enum PosPaymentStatus {
  PENDING
  CONFIRMED
}

model CashSession {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  status CashSessionStatus @default(OPEN)
  openingAmount Decimal @db.Decimal(12, 2)
  openedAt DateTime @default(now())
  closedAt DateTime?
  countedAmount Decimal? @db.Decimal(12, 2)
  expectedAmount Decimal? @db.Decimal(12, 2)
  difference Decimal? @db.Decimal(12, 2)
  closingNote String?
  entries CashEntry[]
  payments PosPayment[]
  refunds PosRefund[]

  @@index([userId, openedAt])
  @@index([openedAt])
  @@map("cash_sessions")
}

model CashEntry {
  id String @id @default(cuid())
  sessionId String
  session CashSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind String
  amount Decimal @db.Decimal(12, 2)
  reason String
  reference String?
  sourceKey String @unique
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@map("cash_entries")
}

model PosSale {
  id String @id @default(cuid())
  orderId String? @unique
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  userId String
  user User @relation("PosSaleActor", fields: [userId], references: [id], onDelete: Restrict)
  status PosSaleStatus @default(PENDING)
  cancellationReason String?
  customerName String?
  customerDocument String?
  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @db.Decimal(12, 2)
  discountReason String?
  approvedById String?
  approvedBy User? @relation("PosSaleApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  total Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  confirmedAt DateTime?
  items PosSaleItem[]
  payments PosPayment[]
  refunds PosRefund[]

  @@index([confirmedAt, userId])
  @@index([userId, createdAt])
  @@map("pos_sales")
}

model PosSaleItem {
  id String @id @default(cuid())
  saleId String
  sale PosSale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  name String
  sku String
  quantity Int
  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(12, 2)
  returns PosRefundItem[]

  @@unique([saleId, productId])
  @@index([productId])
  @@map("pos_sale_items")
}

model PosPayment {
  id String @id @default(cuid())
  saleId String
  sale PosSale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  method String
  amount Decimal @db.Decimal(12, 2)
  received Decimal @db.Decimal(12, 2)
  change Decimal @db.Decimal(12, 2)
  status PosPaymentStatus @default(PENDING)
  reference String?
  confirmedById String?
  confirmedBy User? @relation(fields: [confirmedById], references: [id], onDelete: Restrict)
  sessionId String?
  session CashSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  confirmedAt DateTime?

  @@unique([saleId, method])
  @@index([method, confirmedAt])
  @@index([confirmedAt, confirmedById])
  @@index([sessionId])
  @@map("pos_payments")
}

model PosRefund {
  id String @id @default(cuid())
  saleId String
  sale PosSale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessionId String
  session CashSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  kind String
  amount Decimal @db.Decimal(12, 2)
  method String
  reference String?
  reason String
  createdAt DateTime @default(now())
  items PosRefundItem[]

  @@index([createdAt, userId])
  @@index([saleId])
  @@map("pos_refunds")
}

model PosRefundItem {
  id String @id @default(cuid())
  refundId String
  refund PosRefund @relation(fields: [refundId], references: [id], onDelete: Restrict)
  saleItemId String
  saleItem PosSaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  quantity Int
  restock Boolean
  amount Decimal @db.Decimal(12, 2)

  @@unique([refundId, saleItemId])
  @@index([saleItemId])
  @@map("pos_refund_items")
}

model PosOperation {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind String
  requestHash String
  response Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("pos_operations")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProductReview {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  userId String
  user User @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Restrict)
  orderItemId String @unique
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  rating Int
  title String? @db.VarChar(80)
  text String @db.VarChar(1000)
  status ReviewStatus @default(PENDING)
  storeReply String? @db.VarChar(1000)
  rejectionReason String? @db.VarChar(500)
  moderatedById String?
  moderatedBy User? @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: Restrict)
  moderatedAt DateTime?
  repliedAt DateTime?
  helpfulCount Int @default(0)
  votes ReviewHelpfulVote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, productId])
  @@index([productId, status, createdAt, id])
  @@index([productId, status, helpfulCount, createdAt, id])
  @@index([status, createdAt, id])
  @@index([moderatedById])
  @@map("product_reviews")
}

model ReviewHelpfulVote {
  id String @id @default(cuid())
  reviewId String
  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@unique([reviewId, userId])
  @@index([userId])
  @@map("review_helpful_votes")
}

model ReviewInvitation {
  id String @id @default(cuid())
  orderItemId String @unique
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  startedAt DateTime @default(now())
  sentAt DateTime?
  providerId String?
  @@map("review_invitations")
}

model OrderEmailDelivery {
  id String @id
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status OrderStatus
  state String @default("PENDING")
  firstAttemptAt DateTime?
  lastAttemptAt DateTime?
  sentAt DateTime?
  providerId String?
  attempts Int @default(0)
  lastErrorCode String?
  createdAt DateTime @default(now())
  @@unique([orderId, status], map: "order_email_deliveries_order_status_key")
  @@index([state, createdAt, id], map: "order_email_deliveries_state_created_idx")
  @@map("order_email_deliveries")
}
