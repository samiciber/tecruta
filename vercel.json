{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|googlebot|bingbot|WhatsApp|facebookexternalhit|Twitterbot|LinkedInBot|Slackbot).*"
        }
      ],
      "destination": "/api/share?path=/"
    },
    {
      "source": "/:kind(producto|categoria|marca)/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|googlebot|bingbot|WhatsApp|facebookexternalhit|Twitterbot|LinkedInBot|Slackbot).*"
        }
      ],
      "destination": "/api/share?path=/:kind/:slug"
    },
    {
      "source": "/:page(catalogo|marcas|ayuda)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|googlebot|bingbot|WhatsApp|facebookexternalhit|Twitterbot|LinkedInBot|Slackbot).*"
        }
      ],
      "destination": "/api/share?path=/:page"
    },
    {
      "source": "/legal/:type(terminos|privacidad)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|googlebot|bingbot|WhatsApp|facebookexternalhit|Twitterbot|LinkedInBot|Slackbot).*"
        }
      ],
      "destination": "/api/share?path=/legal/:type"
    },
    {
      "source": "/((?!api/|assets/|robots.txt|manifest.webmanifest|favicon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data: blob:; connect-src 'self' https://tecruta.onrender.com https://res.cloudinary.com https://www.gstatic.com https://raw.githack.com; worker-src 'self' blob:; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tecruta-panel.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/:private(admin|pos|panel|mi-cuenta|cuenta|carrito|checkout|iniciar-sesion|crear-cuenta|recuperar-contrasena|verificar-correo|mis-pedidos|mis-direcciones|elementos-guardados|pagos|mi-tarjeta|planes|auth)/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "mejora/tienda-estilo-profesional": false
    }
  }
}
