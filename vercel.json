{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data: blob:; connect-src 'self' https://tecruta.onrender.com https://res.cloudinary.com https://www.gstatic.com https://raw.githack.com; worker-src 'self' blob:; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin.tecruta.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "www.tecruta.com"
        }
      ],
      "destination": "https://admin.tecruta.com/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.tecruta.com"
        }
      ],
      "destination": "https://admin.tecruta.com/:path*",
      "permanent": false
    },
    {
      "source": "/pos",
      "has": [
        {
          "type": "host",
          "value": "www.tecruta.com"
        }
      ],
      "destination": "https://admin.tecruta.com/pos",
      "permanent": false
    },
    {
      "source": "/pos/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.tecruta.com"
        }
      ],
      "destination": "https://admin.tecruta.com/pos/:path*",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "tecruta.com"
        }
      ],
      "destination": "https://admin.tecruta.com/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "tecruta.com"
        }
      ],
      "destination": "https://admin.tecruta.com/:path*",
      "permanent": false
    },
    {
      "source": "/pos",
      "has": [
        {
          "type": "host",
          "value": "tecruta.com"
        }
      ],
      "destination": "https://admin.tecruta.com/pos",
      "permanent": false
    },
    {
      "source": "/pos/:path*",
      "has": [
        {
          "type": "host",
          "value": "tecruta.com"
        }
      ],
      "destination": "https://admin.tecruta.com/pos/:path*",
      "permanent": false
    }
  ]
}
